{
  "name": "mandate-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:agents": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs scripts/eval-agents.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "eval:drafter": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs scripts/eval-drafter.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.66",
    "@ai-sdk/openai-compatible": "^3.0.65",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^1.19.12",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "ai": "^7.0.127",
    "ai-sdk-ollama": "^4.4.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
