{
  "name": "mandate-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:agents": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs scripts/eval-agents.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "check:mcp": "tsx scripts/check-mcp.ts",
    "check:oauth": "tsx scripts/check-oauth.ts",
    "smoke": "tsx scripts/smoke.ts",
    "studio:e2e": "tsx scripts/studio-e2e.ts",
    "webhook:register": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs scripts/register-webhook.ts",
    "eval:drafter": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs scripts/eval-drafter.ts",
    "eval:policy": "node --env-file=../.env ./node_modules/tsx/dist/cli.mjs scripts/eval-policy.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.85",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@simplewebauthn/server": "14.0.3",
    "ai": "^7.0.154",
    "ai-sdk-ollama": "^4.5.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "fast-check": "4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
