    {
      "name": "Deals, signatures and agents",
      "item": [
        {
          "name": "Offer $450 (studio): over the client's limit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-deal-450-{{$timestamp}}"
              }
            ],
            "url": "{{baseUrl}}/v1/deals/offers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyer\": \"Northwind\",\n  \"as\": \"seller\",\n  \"terms\": {\n    \"scope\": \"Spring launch logo\",\n    \"category\": \"design\",\n    \"currency\": \"USD\",\n    \"totalCents\": 45000,\n    \"milestones\": [\n      {\n        \"title\": \"Concepts\",\n        \"amountCents\": 22500\n      },\n      {\n        \"title\": \"Final files\",\n        \"amountCents\": 22500\n      }\n    ],\n    \"proofRequired\": true\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('refused: over the buyer limit, and the limit is not revealed', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(b.status).to.eql('refused');",
                  "  pm.expect(b.verdict.violations[0].code).to.eql('deal.over_buyer_limit');",
                  "});"
                ]
              }
