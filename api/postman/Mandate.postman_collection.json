{
  "info": {
    "name": "Mandate API",
    "description": "Spending warrant API. Import the local environment with it. Health checks are public. Everything under /v1 uses Authorization: Bearer {{apiKey}}. POST /v1/proposals requires Idempotency-Key. Amounts are integer cents. A deny is HTTP 201 with gate DENY and a null orderId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8787"
    },
    {
      "key": "proposalId",
      "value": ""
    },
    {
      "key": "captureId",
      "value": ""
    },
    {
      "key": "chargeId",
      "value": ""
    },
    {
      "key": "fundingCaptureId",
      "value": ""
    },
    {
      "key": "dealId",
      "value": ""
    },
    {
      "key": "dealChargeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 health+json', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/health+json');",
                  "  pm.expect(pm.response.json().status).to.eql('pass');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sqlite is readable', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.checks['sqlite:read'][0].status).to.be.oneOf(['pass', 'fail']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('openapi 3.1', function () { pm.expect(pm.response.json().openapi).to.eql('3.1.0'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Warrant",
      "item": [
        {
          "name": "Current warrant",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/warrant"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('seeded studio warrant', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.currency).to.eql('USD');",
                  "  pm.expect(body.autoSettleUnderCents).to.eql(2000);",
                  "  pm.expect(body.monthlyCapCents).to.eql(18000);",
                  "  pm.expect(body.payees[0].displayName).to.eql('Priya Shah');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dry runs",
      "item": [
        {
          "name": "Lunch denied",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({ key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$guid}}') });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('category deny has no order', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.gate).to.eql('DENY');",
                  "  pm.expect(body.clause).to.eql('category.missing');",
                  "  pm.expect(body.orderId).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payee\": \"Priya\",\n  \"amountCents\": 1800,\n  \"currency\": \"USD\",\n  \"category\": \"lunch\",\n  \"description\": \"Team lunch\",\n  \"evidenceUrl\": \"https://example.com/lunch\",\n  \"prompt\": \"Buy the team lunch for $18\"\n}"
            },
            "url": "{{baseUrl}}/v1/proposals"
          }
        },
        {
          "name": "Fake vendor $480 denied",
          "event": [
            {
              "listen": "prerequest",
              "script": {
