          }
        },
        {
          "name": "Priya $90 payout: sent through Payouts, never Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('the contractor is paid through PayPal Payouts, not an Orders checkout', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.orderId).to.eql(null);",
                  "  pm.expect(body.payoutBatchId).to.be.a('string');",
                  "  pm.expect(['payout_sent', 'payout_unclaimed', 'captured']).to.include(body.phase);",
                  "  if (body.phase === 'captured') pm.expect(body.capturedAmountCents).to.eql(9000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/v1/proposals/{{proposalId}}/capture"
          }
        },
        {
          "name": "Dispute packet",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/proposals/{{proposalId}}/packet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('packet names the prompt, the clause, the funding and the payout', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.prompt).to.include('Northwind milestone 1');",
                  "  pm.expect(body.clause).to.eql('amount.needs_approval');",
                  "  pm.expect(body.approval.type).to.eql('proposal.approved');",
                  "  pm.expect(body.funding.phase).to.eql('captured');",
                  "  pm.expect(body.payout.batchId).to.be.a('string');",
                  "  pm.expect(body.captureId).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Job receipt",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/jobs/job_northwind_logo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('money in, the $90 payout out or in flight, $60 kept', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.client.displayName).to.eql('Northwind');",
                  "  pm.expect(body.totals.inCents).to.eql(15000);",
                  "  pm.expect(body.totals.outCents + body.totals.heldCents).to.eql(9000);",
                  "  pm.expect(body.totals.keptCents).to.eql(6000);",
