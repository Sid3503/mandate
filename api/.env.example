# Copy to ../.env (repo root) for local sandbox runs. Never commit real values.
# Run with: cd api && node --env-file=../.env ./node_modules/tsx/dist/cli.mjs src/main.ts

# PayPal sandbox app (Developer Dashboard > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com

# Turns the clerk and the negotiating agents on (Ollama Cloud). Optional.
OLLAMA_API_KEY=
# AGENT_MODEL=gpt-oss:20b
# The model that drafts rules from plain words. Measured best and fastest of the models tried; it only drafts, and the owner reads the diff.
# DRAFTER_MODEL=gemma4:31b
# OLLAMA_BASE_URL=https://ollama.com

# Keys. Development defaults exist; production refuses to boot without real ones.
# API_KEY=                 owner: approves, sends, changes rules
# PROPOSER_KEY=            studio staff and agents: ask and read only
# BUYER_AGENT_KEY=         a client's agent: offers deals for one client only
# BUYER_AGENT_PARTY=client_northwind

# Ed25519 private key (PKCS8 PEM) that signs locks and deals. Required in production.
# Development creates one next to the database. Rotate by setting a new key and listing the old PUBLIC keys:
# SIGNING_KEY=
# SIGNING_KEYS_PREVIOUS=   public PEMs separated by |

# The id PayPal gives the webhook you register for https://<host>/v1/webhooks/paypal. With it, every delivery must be signed by PayPal.
# PAYPAL_WEBHOOK_ID=

# "auto" bills clients with PayPal invoices when the app may, and falls back to checkout when it may not.
# INVOICES=auto|off
