{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "notebooklm": {
      "type": "local",
      "command": [
        "/Users/siddharth.mishra/.local/bin/notebooklm-mcp"
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:.opencode.firecrawl_key}"
      }
    }
  }
}
